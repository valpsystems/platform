# VALP SYSTEMS - Backend Configuration
# Copy to .env and fill in values

# Application
APP_NAME=VALP SYSTEMS
APP_VERSION=1.0.0
APP_DESCRIPTION=VALP SYSTEMS Enterprise Backend API
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET_KEY=change-this-to-a-secure-random-key
APP_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/valp_systems
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Testing
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Trusted Hosts
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# Email
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@valpsystems.com
SMTP_FROM_NAME=VALP SYSTEMS

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Redis (optional, for rate limiting / caching)
REDIS_URL=redis://localhost:6379/0

# AWS (optional, for S3 file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
